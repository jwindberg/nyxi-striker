{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NYXI Striker",
  "version": "1.0.0",
  "identifier": "com.jwindberg.nyxi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "NYXI Striker",
        "width": 1000,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/99-nyxi.rules": "linux/99-nyxi.rules"
        },
        "postInstallScript": "linux/postinst.sh"
      }
    }
  }
}
